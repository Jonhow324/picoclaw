# ============================================================
# Minimal runtime image for ARM64 using pre-compiled binaries
# ============================================================
FROM alpine:3.23

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -q --spider http://localhost:18790/health || exit 1

# Copy pre-compiled ARM64 binaries from host build directory
COPY docker/build_tmp/picoclaw-linux-arm64 /usr/local/bin/picoclaw
COPY docker/build_tmp/picoclaw-launcher-linux-arm64 /usr/local/bin/picoclaw-launcher

ENTRYPOINT ["picoclaw-launcher"]
CMD ["-console", "-public", "-no-browser"]
